# Public URL of the deployed site, used for canonical URLs, the sitemap and Open Graph.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. A GitHub token with no scopes. Raises API rate limits and enables the
# full-year contribution calendar in the GitHub activity section.
GITHUB_TOKEN=
